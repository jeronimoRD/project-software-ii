{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/backend/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/backend/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/backend",
  "projects": {
    "asensorista": {
      "type": "library",
      "root": "libs/asensorista",
      "entryFile": "index",
      "sourceRoot": "libs/asensorista/src",
      "compilerOptions": {
        "tsConfigPath": "libs/asensorista/tsconfig.lib.json"
      }
    },
    "auth": {
      "type": "library",
      "root": "libs/auth",
      "entryFile": "index",
      "sourceRoot": "libs/auth/src",
      "compilerOptions": {
        "tsConfigPath": "libs/auth/tsconfig.lib.json"
      }
    },
    "backend": {
      "type": "application",
      "root": "apps/backend",
      "entryFile": "main",
      "sourceRoot": "apps/backend/src",
      "compilerOptions": {
        "tsConfigPath": "apps/backend/tsconfig.app.json"
      }
    },
    "email": {
      "type": "library",
      "root": "libs/email",
      "entryFile": "index",
      "sourceRoot": "libs/email/src",
      "compilerOptions": {
        "tsConfigPath": "libs/email/tsconfig.lib.json"
      }
    },
    "entities": {
      "type": "library",
      "root": "libs/entities",
      "entryFile": "index",
      "sourceRoot": "libs/entities/src",
      "compilerOptions": {
        "tsConfigPath": "libs/entities/tsconfig.lib.json"
      }
    },
    "hotel": {
      "type": "application",
      "root": "apps/hotel",
      "entryFile": "main",
      "sourceRoot": "apps/hotel/src",
      "compilerOptions": {
        "tsConfigPath": "apps/hotel/tsconfig.app.json"
      }
    },
    "requests": {
      "type": "application",
      "root": "apps/requests",
      "entryFile": "main",
      "sourceRoot": "apps/requests/src",
      "compilerOptions": {
        "tsConfigPath": "apps/requests/tsconfig.app.json"
      }
    },
    "reserves": {
      "type": "application",
      "root": "apps/reserves",
      "entryFile": "main",
      "sourceRoot": "apps/reserves/src",
      "compilerOptions": {
        "tsConfigPath": "apps/reserves/tsconfig.app.json"
      }
    },
    "reviews": {
      "type": "application",
      "root": "apps/reviews",
      "entryFile": "main",
      "sourceRoot": "apps/reviews/src",
      "compilerOptions": {
        "tsConfigPath": "apps/reviews/tsconfig.app.json"
      }
    },
    "rooms": {
      "type": "application",
      "root": "apps/rooms",
      "entryFile": "main",
      "sourceRoot": "apps/rooms/src",
      "compilerOptions": {
        "tsConfigPath": "apps/rooms/tsconfig.app.json"
      }
    },
    "user": {
      "type": "application",
      "root": "apps/user",
      "entryFile": "main",
      "sourceRoot": "apps/user/src",
      "compilerOptions": {
        "tsConfigPath": "apps/user/tsconfig.app.json"
      }
    }
  }
}